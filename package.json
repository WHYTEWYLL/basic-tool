{
  "name": "test-application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && npx prisma generate --schema=prisma/vector/vector-schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:drop": "drizzle-kit drop",
    "db:pull": "drizzle-kit introspect",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "vector:generate": "prisma generate --schema=prisma/vector/vector-schema.prisma",
    "vector:migrate": "prisma migrate dev --schema=prisma/vector/vector-schema.prisma",
    "vector:migrate:prod": "prisma migrate deploy --schema=prisma/vector-schema.prisma",
    "vector:studio": "prisma studio --schema=prisma/vector-schema.prisma",
    "postinstall": "npx prisma generate && npx prisma generate --schema=prisma/vector/vector-schema.prisma"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.68",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "ai": "^4.1.54",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.31.2",
    "drizzle-zod": "^0.5.1",
    "lucide-react": "^0.396.0",
    "nanoid": "^5.0.7",
    "next": "15.2.1",
    "next-themes": "^0.3.0",
    "openai-edge": "^1.2.2",
    "pdf2json": "^3.1.6",
    "postgres": "^3.4.4",
    "prisma": "^6.8.2",
    "react": "^18",
    "react-dom": "^18",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/ui": "^3.1.4",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.22.7",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "pg": "^8.12.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.15.7",
    "typescript": "^5",
    "vitest": "^3.1.4"
  }
}