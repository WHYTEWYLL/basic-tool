generator vectorClient {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/vector-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource vectorDb {
  provider = "postgresql"
  url      = env("VECTOR_DATABASE_URL")
}

model Resource {
  id         String      @id @default(uuid())
  content    String
  filename   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  embeddings Embedding[]
}

model Embedding {
  id         String                      @id @default(uuid())
  resourceId String
  content    String
  embedding  Unsupported("vector(1536)")
  resource   Resource                    @relation(fields: [resourceId], references: [id])

  @@index([resourceId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String // VeChain wallet address
  sessionId String? // Optional session ID for grouping conversations
  role      String // 'conversation' for grouped messages
  content   Json // Store array of CoreMessage objects
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
